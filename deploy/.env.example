# Значения без кавычек и без инлайн-комментариев после значения; секреты и пароли — только A-Za-z0-9_- (файл читают make, compose, bash и Go)

# Telegram Bot
TELEGRAM_APITOKEN=
# ADMIN_CHAT_ID — админский чат (любой участник = админ), LOG_CHAT_ID — группа для логов
ADMIN_CHAT_ID=
LOG_CHAT_ID=
# secret_token для setWebhook: 32..256 символов A-Za-z0-9_- (openssl rand -hex 32)
WEBHOOK_SECRET=
# drop_pending_updates при setWebhook: false; true только до начала голосования
DROP_PENDING=

# Database (POSTGRES_HOST/PORT — как в docker-compose.yml)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_SSLMODE=

# Email: EMAIL_PROVIDER=smtp (по умолчанию в коде) | postbox (HTTPS-API Yandex Cloud Postbox, если SMTP-порты закрыты)
EMAIL_PROVIDER=postbox
# адрес отправителя для обоих провайдеров
SMTP_EMAIL=noreply@example.org
# лимит писем в сутки: по умолчанию 180. Считается в памяти процесса и сбрасывается
# рестартом бота, поэтому держать с запасом ниже квоты Postbox (200)
EMAIL_DAILY_LIMIT=
# smtp: mail.ru — smtp.mail.ru, 465 + tls (или 587/2525 + starttls); SMTP_PASSWORD — пароль приложения
# SMTP_USER — логин для релеев; у mail.ru должен совпадать с SMTP_EMAIL (или его алиасом), можно оставить пустым
SMTP_PASSWORD=
SMTP_USER=
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_TLS=tls
# postbox: статический ключ сервисного аккаунта с ролью postbox.sender
POSTBOX_KEY_ID=
POSTBOX_SECRET_KEY=
POSTBOX_ENDPOINT=https://postbox.cloud.yandex.net
POSTBOX_REGION=ru-central1

# App
# DOMAIN — домен для nginx/certbot и ссылки на страницу бюллетеней в сообщении делегату
DOMAIN=
# контакт для Let's Encrypt (setup-domain.sh)
EMAIL=
APP_PORT=
# ключ токенов бюллетеней (openssl rand -hex 32); менять перед каждыми выборами, только до /start_voting
VOTE_TOKEN_SECRET=
TOTAL_PLACES=
# info в проде; debug пишет в лог коды подтверждения и бюллетени
LOG_LEVEL=
TELEGRAM_LOG_LEVEL=

# Development (ngrok: make app2 / make ngrok-docker, сервис ngrok в docker-compose.yml под profile dev)
NGROK_PORT=
NGROK_URL=
NGROK_AUTHTOKEN=
